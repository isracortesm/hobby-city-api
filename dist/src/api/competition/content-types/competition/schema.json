{
    "kind": "collectionType",
    "collectionName": "competitions",
    "info": {
        "singularName": "competition",
        "pluralName": "competitions",
        "displayName": "Competition"
    },
    "options": {
        "draftAndPublish": false
    },
    "pluginOptions": {},
    "attributes": {
        "type": {
            "type": "enumeration",
            "required": true,
            "default": "byCriteria",
            "enum": [
                "byOrder",
                "byCriteria"
            ]
        },
        "hasPublicResults": {
            "type": "boolean",
            "required": true,
            "default": false
        },
        "operationType": {
            "type": "enumeration",
            "required": true,
            "default": "average",
            "enum": [
                "average",
                "sum"
            ]
        },
        "modelsLimit": {
            "type": "integer",
            "required": true,
            "default": 5
        },
        "activity": {
            "type": "relation",
            "relation": "oneToOne",
            "target": "api::activity.activity"
        },
        "models": {
            "type": "relation",
            "relation": "oneToMany",
            "target": "api::competition-model.competition-model",
            "mappedBy": "competition"
        },
        "results": {
            "type": "relation",
            "relation": "oneToMany",
            "target": "api::competition-result.competition-result",
            "mappedBy": "competition"
        },
        "categories": {
            "type": "relation",
            "relation": "oneToMany",
            "target": "api::competition-category.competition-category"
        }
    }
}
